{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "workforce-one-hrms-demo",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-08-26",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05
		}
	},
	"upload_source_maps": true,
	"vars": {
		"APP_ENV": "development",
		"DEMO_MODE": "true"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "workforce-one-demo",
			"database_id": "f0db1320-df5d-4113-971f-06d8cab557f6",
			"migrations_dir": "./drizzle/migrations"
		}
	],
	"triggers": {
		"crons": [
			"0 19 * * *"
		]
	}
}